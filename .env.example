# Credentials for `rhca run`. Copy to .env (gitignored) and fill in; values here
# never leave your machine except to the service each one belongs to. Anything
# already set in your environment wins over this file.

# Robinhood Crypto Trading API (required). Run `rhca keygen`: it fills in
# ROBINHOOD_PRIVATE_KEY and prints the public key to paste into Robinhood's
# "Add key" form (robinhood.com/account/crypto). Enable read-only actions only.
# rhca's client is read-only, and has no method that places or cancels an
# order. rhca run uses it for quotes and trading pairs only: the balance and
# holdings it sizes against are the Agentic account's, fed in with rhca ingest.
ROBINHOOD_API_KEY=
ROBINHOOD_PRIVATE_KEY=

# The crypto account the API key belongs to: its full number, or its last 4
# digits. With this set, rhca run refuses to start if the key reads any other
# account, so a swapped key is caught at startup.
RHCA_CRYPTO_ACCOUNT=

# For placing orders through Claude Code later: the numeric account number
# those orders go to (Robinhood's agent connector trades only your Agentic
# account). The shadow run does not use it.
RHCA_RHS_ACCOUNT_NUMBER=

# TypeSafe AI -- Jev labels each headline (asset, direction, impact).
# Without it, news is fetched but never scored.
TYPESAFE_API_KEY=

# Anthropic -- Claude Sonnet 5 judges escalated candidates (System 2).
# Without it, candidates that clear the trigger are logged as not approved.
ANTHROPIC_API_KEY=

# The Vercel sign-off dashboard (optional).
RHCA_DASHBOARD_URL=
RHCA_DASHBOARD_TOKEN=
