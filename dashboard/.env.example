# Shared secret between `rhca dashboard-sync` and this dashboard.
# Generate one with:  openssl rand -hex 32
# Set the SAME value as RHCA_DASHBOARD_TOKEN where the agent runs.
RHCA_DASHBOARD_TOKEN=

# Optional: link back to the repository from the dashboard header.
NEXT_PUBLIC_REPO_URL=https://github.com/joman124/robinhood-crypto-agent

# Storage. With Vercel KV (or any Upstash Redis) connected, these are set for
# you by the Vercel integration and state survives restarts and cold starts.
# Without them the dashboard falls back to in-process memory, which is fine for
# `npm run dev` and useless in production -- serverless instances do not share
# memory, so decisions would be lost. The UI says so plainly when this happens.
KV_REST_API_URL=
KV_REST_API_TOKEN=
