# Copy to .env and fill in as needed. Never commit the real .env file.
#
# This agent does NOT talk to Robinhood directly — all account access, quotes,
# and order execution go through the `robinhood-trading` MCP server configured
# in .mcp.json, authenticated via Claude Code's own connection/session
# handshake. No Robinhood credentials belong in this file.
#
# If the MCP server transport ever requires a static token/header (it doesn't
# by default), set it here and reference it from .mcp.json as ${VAR_NAME} —
# never hardcode it in .mcp.json.
# ROBINHOOD_MCP_TOKEN=

# Optional: override the free-tier public data providers used for backtesting
# and the sentiment signal if you have a preferred/paid alternative later.
# COINGECKO_API_BASE=https://api.coingecko.com/api/v3
# FEAR_GREED_API_BASE=https://api.alternative.me/fng
